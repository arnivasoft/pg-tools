---
source: crates/pgt-ddl/src/data/select.rs
expression: render(&cases)
---
-- PK'lı tablo varsayılan (version_index=3, has_version=true)
SELECT id, "name", status, xmin::text AS __pgt_xmin FROM public.t ORDER BY id ASC

-- çok kolonlu anahtar varsayılan sıralama (version_index=3, has_version=true)
SELECT a, b, c, xmin::text AS __pgt_xmin FROM "App"."Orders" ORDER BY c ASC, a ASC

-- istek sıralaması (desc) (version_index=3, has_version=true)
SELECT a, b, c, xmin::text AS __pgt_xmin FROM "App"."Orders" ORDER BY b DESC, a ASC

-- filtreli (version_index=3, has_version=true)
SELECT id, "name", status, xmin::text AS __pgt_xmin FROM public.t WHERE (status = 'a'
) ORDER BY id ASC

-- anahtarsız tablo (version_index=2, has_version=true)
SELECT x, y, xmin::text AS __pgt_xmin FROM public.t

-- bölümlü tablo (version_index=2, has_version=true)
SELECT id, k, xmin::text AS __pgt_xmin FROM public.p ORDER BY id ASC, k ASC

-- görünüm (version_index=2, has_version=false)
SELECT id, v FROM public.v ORDER BY v DESC

-- MV (version_index=1, has_version=false)
SELECT id FROM public.m

-- yabancı tablo (version_index=1, has_version=false)
SELECT id FROM public.f

-- boşluk filtre yok sayılır (version_index=3, has_version=true)
SELECT id, "name", status, xmin::text AS __pgt_xmin FROM public.t ORDER BY id ASC

-- kolonsuz tablo (version_index=0, has_version=true)
SELECT xmin::text AS __pgt_xmin FROM public.t

-- kolonsuz görünüm (version_index=0, has_version=false)
SELECT FROM public.v0
