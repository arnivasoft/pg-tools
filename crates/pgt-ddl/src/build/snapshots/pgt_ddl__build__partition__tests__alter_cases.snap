# range → range
[Destructive] ALTER TABLE public.measurement DETACH PARTITION public.m_2024  -- Bölüm aynı transaction içinde yeniden bağlanır; tablo yeniden taranır.
[Destructive] ALTER TABLE public.measurement ATTACH PARTITION public.m_2024 FOR VALUES FROM (('2025-01-01'
)) TO (('2026-01-01'
))  -- Bölüm aynı transaction içinde yeniden bağlanır; tablo yeniden taranır.

# range → default
[Destructive] ALTER TABLE public.measurement DETACH PARTITION public.m_2024  -- Bölüm aynı transaction içinde yeniden bağlanır; tablo yeniden taranır.
[Destructive] ALTER TABLE public.measurement ATTACH PARTITION public.m_2024 DEFAULT  -- Bölüm aynı transaction içinde yeniden bağlanır; tablo yeniden taranır.
