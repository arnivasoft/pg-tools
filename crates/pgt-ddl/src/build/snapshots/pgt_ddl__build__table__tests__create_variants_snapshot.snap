## UNIQUE NULLS NOT DISTINCT + INCLUDE, CHECK NO INHERIT, adsız kısıtlar @150000
[Safe] CREATE TABLE public.t (
  a integer,
  b text,
  c text,
  UNIQUE NULLS NOT DISTINCT (a, b) INCLUDE (c),
  CHECK (a > 0 /* ) */
) NO INHERIT,
  CONSTRAINT pk PRIMARY KEY (a) DEFERRABLE
)

## bölümlenmiş RANGE (kolon + ifade) @100000
[Safe] CREATE TABLE public.t (
  id bigint NOT NULL,
  created timestamp with time zone,
  region text,
  CONSTRAINT id_ck CHECK (id > 0
)
) PARTITION BY RANGE (created, (lower(region)
))

