## tam @180000
[Safe] CREATE UNLOGGED TABLE public.t (
  id bigint GENERATED ALWAYS AS IDENTITY NOT NULL,
  "Name" character varying(50) COLLATE "C" NOT NULL,
  qty integer DEFAULT (0
) NOT NULL,
  total numeric(10,2) GENERATED ALWAYS AS (qty * 2
) STORED,
  note text,
  CONSTRAINT t_pkey PRIMARY KEY (id),
  UNIQUE ("Name") INCLUDE (qty),
  CONSTRAINT qty_ck CHECK (qty >= 0
),
  CONSTRAINT fk FOREIGN KEY (qty) REFERENCES public.u (id) MATCH FULL ON UPDATE CASCADE ON DELETE SET NULL DEFERRABLE INITIALLY DEFERRED
) WITH (fillfactor = 70) TABLESPACE fast
[Safe] ALTER TABLE public.t OWNER TO app
[Safe] COMMENT ON TABLE public.t IS 'Tablo'
[Safe] COMMENT ON COLUMN public.t."Name" IS 'it''s'
[Safe] COMMENT ON COLUMN public.t.note IS E'a\\b'

