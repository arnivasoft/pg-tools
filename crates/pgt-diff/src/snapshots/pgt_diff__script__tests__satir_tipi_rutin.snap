-- pg-tools şema karşılaştırma betiği
-- Kaynak: kaynak.public
-- Hedef: hedef.Hedef Şema (PostgreSQL 16.4)
-- Oluşturuldu: 2026-10-31 00:00:00 UTC
-- Öğe: 7, ifade: 8, en yüksek risk: Güvenli
-- Bağımlılıklar tamamlanmaz: seçilmeyen nesnelere bağlı öğeler hedefte hata verebilir.

BEGIN;
SET LOCAL check_function_bodies = off;
SET LOCAL search_path TO pg_catalog, "Hedef Şema";

-- ==== Oluşturma ve değişiklikler ====
-- Fonksiyon z_plain
CREATE FUNCTION plain();
-- Tablo t
CREATE TABLE t (id int);
-- Fonksiyon a_f
CREATE FUNCTION f() RETURNS SETOF t;
-- Görünüm v
CREATE VIEW v AS SELECT 1;
-- Fonksiyon a_g
CREATE FUNCTION g(r v);
-- Fonksiyon a_h
CREATE FUNCTION h(a t, b v);
-- İndeks i
CREATE INDEX i ON t (id);

-- ==== Yetkiler ====
-- Fonksiyon a_f
GRANT EXECUTE ON FUNCTION f() TO r;

COMMIT;
