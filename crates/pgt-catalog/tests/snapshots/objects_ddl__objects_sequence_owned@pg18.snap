-- Sequence: app.orders_id_seq

-- DROP SEQUENCE IF EXISTS app.orders_id_seq;

CREATE SEQUENCE IF NOT EXISTS app.orders_id_seq
    AS bigint
    INCREMENT BY 1
    MINVALUE 1
    MAXVALUE 9223372036854775807
    START WITH 1
    CACHE 1
    NO CYCLE;

ALTER SEQUENCE app.orders_id_seq
    OWNED BY app.orders.id;

ALTER SEQUENCE app.orders_id_seq
    OWNER TO <owner>;
