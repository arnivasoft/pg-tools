-- Domain: app.positive_int

-- DROP DOMAIN IF EXISTS app.positive_int;

CREATE DOMAIN app.positive_int AS integer
    DEFAULT 1
    NOT NULL
    CONSTRAINT positive_check CHECK (VALUE > 0);

ALTER DOMAIN app.positive_int
    OWNER TO <owner>;
