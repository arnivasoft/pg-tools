-- Table: extra.tickets

-- DROP TABLE IF EXISTS extra.tickets;

CREATE TABLE IF NOT EXISTS extra.tickets
(
    id integer NOT NULL GENERATED BY DEFAULT AS IDENTITY (START WITH 10 INCREMENT BY 2 MINVALUE 1 MAXVALUE 2147483647 CACHE 1),
    title text NOT NULL
);

ALTER TABLE IF EXISTS extra.tickets
    OWNER TO <owner>;
