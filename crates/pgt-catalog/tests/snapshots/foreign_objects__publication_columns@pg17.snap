-- Publication: pgt_pub_cols

-- DROP PUBLICATION IF EXISTS pgt_pub_cols;

CREATE PUBLICATION pgt_pub_cols
    FOR TABLE public.pub_t, public.pub_t2 (id, v) WHERE (id > 10)
    WITH (publish = 'insert, update, delete, truncate', publish_via_partition_root = false);

ALTER PUBLICATION pgt_pub_cols
    OWNER TO <owner>;
