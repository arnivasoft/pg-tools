-- Role: pgt_app

-- DROP ROLE IF EXISTS pgt_app;

CREATE ROLE pgt_app WITH
    LOGIN
    NOSUPERUSER
    INHERIT
    NOCREATEDB
    NOCREATEROLE
    NOREPLICATION
    NOBYPASSRLS
    CONNECTION LIMIT 5;

GRANT pgt_reader TO pgt_app;
