-- Table: app.orders

-- DROP TABLE IF EXISTS app.orders;

CREATE TABLE IF NOT EXISTS app.orders
(
    id bigint NOT NULL DEFAULT nextval('app.orders_id_seq'::regclass),
    customer_id bigint NOT NULL,
    total numeric(12,2) NOT NULL DEFAULT 0,
    placed_on date NOT NULL,
    CONSTRAINT orders_pkey PRIMARY KEY (id),
    CONSTRAINT orders_customer_id_fkey FOREIGN KEY (customer_id) REFERENCES app.customers(id) ON DELETE CASCADE
)
WITH (fillfactor=80);

ALTER TABLE IF EXISTS app.orders
    OWNER TO <owner>;

CREATE INDEX orders_customer_idx ON app.orders USING btree (customer_id, placed_on DESC) WHERE (total > (0)::numeric);
COMMENT ON INDEX app.orders_customer_idx
    IS 'Müşteri dizini';
